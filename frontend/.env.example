# URL base da API REST. Sem esta variável, o front-end usa "/api" e o proxy do Vite (vite.config.js).
# Local, com o back-end em outra porta:
# VITE_API_URL=http://localhost:8080/api
# Na Vercel (Settings → Environment Variables), o endereço da API no Render:
# VITE_API_URL=https://moeda-estudantil-pucminas-api.onrender.com/api
